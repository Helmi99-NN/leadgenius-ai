import { useState, useRef } from 'react'
import { motion, AnimatePresence } from 'framer-motion'

// ─── Helpers ───────────────────────────────────────────────────
const formatRupiah = (num) => {
  if (!num && num !== 0) return ''
  return 'Rp.' + Number(num).toLocaleString('id-ID')
}

const todayString = () => {
  const d = new Date()
  const months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']
  return `Malang, ${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`
}

const todayISO = () => {
  const d = new Date()
  return d.toISOString().split('T')[0]
}

// ─── Default State ─────────────────────────────────────────────
const emptyItem = () => ({
  id: Date.now() + Math.random(),
  nama: '',
  spesifikasi: '',
  qty: 1,
  harga: 0,
})

const defaultKeterangan = [
  'Pengerjaan mesin setelah DP masuk ke Rekening BCA 0113582348 a/n CV.Asianindo.',
  'Harga diatas belum termasuk ongkos kirim ke lokasi',
  'Skema Pembayaran DP',
  '- Dp awal 30%',
  '- Dp ke 2 senilai 40% setelah mesin siap di uji coba',
  '- Dp ke 3 (pelunasan) 30%, setelah mesin siap dikirim',
]

// ─── Main Component ────────────────────────────────────────────
export default function InvoiceGeneratorPage() {
  const [clientName, setClientName] = useState('')
  const [clientLocation, setClientLocation] = useState('')
  const [invoiceDate, setInvoiceDate] = useState(todayISO())
  const [items, setItems] = useState([emptyItem()])
  const [ongkirDesc, setOngkirDesc] = useState('')
  const [ongkirPrice, setOngkirPrice] = useState(0)
  const [ppnEnabled, setPpnEnabled] = useState(true)
  const [ppnPercent, setPpnPercent] = useState(11)
  const [keterangan, setKeterangan] = useState(defaultKeterangan.join('\n'))
  const [showPreview, setShowPreview] = useState(false)
  const printRef = useRef(null)

  // ─── Calculations ──────────────────────────────────────────
  const subtotalBarang = items.reduce((s, it) => s + (it.qty * it.harga), 0)
  const ppnAmount = ppnEnabled ? Math.round(subtotalBarang * ppnPercent / 100) : 0
  const grandTotal = subtotalBarang + Number(ongkirPrice || 0) + ppnAmount

  // ─── Item CRUD ─────────────────────────────────────────────
  const addItem = () => setItems(prev => [...prev, emptyItem()])
  const removeItem = (id) => setItems(prev => prev.filter(it => it.id !== id))
  const updateItem = (id, field, value) => {
    setItems(prev => prev.map(it => it.id === id ? { ...it, [field]: value } : it))
  }

  // ─── Date formatting ──────────────────────────────────────
  const formattedDate = (() => {
    const d = new Date(invoiceDate + 'T00:00:00')
    const months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']
    return `Malang, ${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`
  })()

  // ─── Print ─────────────────────────────────────────────────
  const handlePrint = () => {
    window.print()
  }

  // ─── Animations ────────────────────────────────────────────
  const fadeUp = {
    initial: { opacity: 0, y: 20 },
    animate: { opacity: 1, y: 0 },
    transition: { duration: 0.4 }
  }

  return (
    <div className="min-h-screen">
      {/* ═══════════ FORM AREA (hidden on print) ═══════════ */}
      <div className="invoice-form-area p-4 md:p-6 lg:p-8">
        {/* Page Header */}
        <motion.div {...fadeUp} className="mb-8">
          <div className="flex items-center gap-3 mb-2">
            <div className="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#2d1b69] to-[#6c3fb5] flex items-center justify-center shadow-lg shadow-purple-500/20">
              <span className="material-symbols-outlined text-white text-2xl" style={{ fontVariationSettings: "'FILL' 1" }}>receipt_long</span>
            </div>
            <div>
              <h1 className="text-2xl font-bold text-gray-900">Generator Invoice</h1>
              <p className="text-sm text-gray-500">Buat invoice profesional dalam hitungan detik</p>
            </div>
          </div>
        </motion.div>

        <div className="grid grid-cols-1 xl:grid-cols-2 gap-6">
          {/* ─── LEFT: Form Input ─────────────────────────── */}
          <motion.div {...fadeUp} transition={{ delay: 0.1, duration: 0.4 }}>
            <div className="space-y-5">
              {/* Card: Info Pelanggan */}
              <div className="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                <div className="bg-gradient-to-r from-[#2d1b69] to-[#4a2d8a] px-5 py-3.5">
                  <h2 className="text-white font-semibold flex items-center gap-2">
                    <span className="material-symbols-outlined text-lg">person</span>
                    Informasi Pelanggan
                  </h2>
                </div>
                <div className="p-5 space-y-4">
                  <div>
                    <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Kepada Yth.</label>
                    <input
                      type="text"
                      value={clientName}
                      onChange={e => setClientName(e.target.value)}
                      placeholder="Contoh: Qahwa Coffee Roastery"
                      className="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 outline-none transition-all text-sm bg-gray-50/50"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Lokasi / Kota</label>
                    <input
                      type="text"
                      value={clientLocation}
                      onChange={e => setClientLocation(e.target.value)}
                      placeholder="Contoh: Makassar"
                      className="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 outline-none transition-all text-sm bg-gray-50/50"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Tanggal Invoice</label>
                    <input
                      type="date"
                      value={invoiceDate}
                      onChange={e => setInvoiceDate(e.target.value)}
                      className="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 outline-none transition-all text-sm bg-gray-50/50"
                    />
                  </div>
                </div>
              </div>

              {/* Card: Daftar Barang */}
              <div className="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                <div className="bg-gradient-to-r from-[#2d1b69] to-[#4a2d8a] px-5 py-3.5 flex items-center justify-between">
                  <h2 className="text-white font-semibold flex items-center gap-2">
                    <span className="material-symbols-outlined text-lg">inventory_2</span>
                    Daftar Barang / Mesin
                  </h2>
                  <button
                    onClick={addItem}
                    className="flex items-center gap-1 text-xs font-semibold text-white bg-white/20 hover:bg-white/30 px-3 py-1.5 rounded-lg transition-colors"
                  >
                    <span className="material-symbols-outlined text-sm">add</span>
                    Tambah
                  </button>
                </div>
                <div className="p-5 space-y-4">
                  <AnimatePresence>
                    {items.map((item, idx) => (
                      <motion.div
                        key={item.id}
                        initial={{ opacity: 0, height: 0 }}
                        animate={{ opacity: 1, height: 'auto' }}
                        exit={{ opacity: 0, height: 0 }}
                        className="relative bg-gray-50/80 rounded-xl p-4 border border-gray-100"
                      >
                        <div className="flex items-center justify-between mb-3">
                          <span className="text-xs font-bold text-purple-600 bg-purple-50 px-2.5 py-1 rounded-lg">
                            Barang #{idx + 1}
                          </span>
                          {items.length > 1 && (
                            <button
                              onClick={() => removeItem(item.id)}
                              className="text-red-400 hover:text-red-600 transition-colors"
                            >
                              <span className="material-symbols-outlined text-lg">delete</span>
                            </button>
                          )}
                        </div>
                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                          <div className="sm:col-span-2">
                            <label className="block text-xs font-medium text-gray-500 mb-1">Nama Barang</label>
                            <input
                              type="text"
                              value={item.nama}
                              onChange={e => updateItem(item.id, 'nama', e.target.value)}
                              placeholder="Mesin Spray Dryer"
                              className="w-full px-3 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 outline-none transition-all text-sm"
                            />
                          </div>
                          <div className="sm:col-span-2">
                            <label className="block text-xs font-medium text-gray-500 mb-1">Spesifikasi (satu per baris)</label>
                            <textarea
                              value={item.spesifikasi}
                              onChange={e => updateItem(item.id, 'spesifikasi', e.target.value)}
                              placeholder={"Kapasitas 1 Liter/Proses\nPemanas Element\nDaya Heater 9.000 Watt\nJumlah Element: 5 Pcs"}
                              rows={4}
                              className="w-full px-3 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 outline-none transition-all text-sm resize-none"
                            />
                          </div>
                          <div>
                            <label className="block text-xs font-medium text-gray-500 mb-1">Qty</label>
                            <input
                              type="number"
                              min="1"
                              value={item.qty}
                              onChange={e => updateItem(item.id, 'qty', parseInt(e.target.value) || 1)}
                              className="w-full px-3 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 outline-none transition-all text-sm"
                            />
                          </div>
                          <div>
                            <label className="block text-xs font-medium text-gray-500 mb-1">Harga Satuan (Rp)</label>
                            <input
                              type="number"
                              min="0"
                              value={item.harga || ''}
                              onChange={e => updateItem(item.id, 'harga', parseInt(e.target.value) || 0)}
                              placeholder="30200000"
                              className="w-full px-3 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 outline-none transition-all text-sm"
                            />
                          </div>
                        </div>
                        {item.harga > 0 && (
                          <div className="mt-3 text-right text-sm font-semibold text-purple-700">
                            Total: {formatRupiah(item.qty * item.harga)}
                          </div>
                        )}
                      </motion.div>
                    ))}
                  </AnimatePresence>
                </div>
              </div>

              {/* Card: Ongkir & PPN */}
              <div className="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                <div className="bg-gradient-to-r from-[#2d1b69] to-[#4a2d8a] px-5 py-3.5">
                  <h2 className="text-white font-semibold flex items-center gap-2">
                    <span className="material-symbols-outlined text-lg">local_shipping</span>
                    Ongkir & Pajak
                  </h2>
                </div>
                <div className="p-5 space-y-4">
                  <div>
                    <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Deskripsi Ongkir</label>
                    <input
                      type="text"
                      value={ongkirDesc}
                      onChange={e => setOngkirDesc(e.target.value)}
                      placeholder="Ongkir Ke Pelabuhan Surabaya"
                      className="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 outline-none transition-all text-sm bg-gray-50/50"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Biaya Ongkir (Rp)</label>
                    <input
                      type="number"
                      min="0"
                      value={ongkirPrice || ''}
                      onChange={e => setOngkirPrice(parseInt(e.target.value) || 0)}
                      placeholder="800000"
                      className="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 outline-none transition-all text-sm bg-gray-50/50"
                    />
                  </div>
                  <div className="flex items-center gap-3 bg-purple-50 rounded-xl p-4 border border-purple-100">
                    <label className="relative inline-flex items-center cursor-pointer">
                      <input
                        type="checkbox"
                        checked={ppnEnabled}
                        onChange={e => setPpnEnabled(e.target.checked)}
                        className="sr-only peer"
                      />
                      <div className="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                    </label>
                    <div className="flex-1">
                      <p className="text-sm font-semibold text-gray-700">PPN {ppnPercent}%</p>
                      <p className="text-xs text-gray-500">Dihitung dari subtotal barang (tidak termasuk ongkir)</p>
                    </div>
                    {ppnEnabled && (
                      <input
                        type="number"
                        min="1"
                        max="100"
                        value={ppnPercent}
                        onChange={e => setPpnPercent(parseInt(e.target.value) || 11)}
                        className="w-16 px-2 py-1.5 border border-purple-200 rounded-lg text-center text-sm font-semibold text-purple-700 bg-white"
                      />
                    )}
                  </div>
                </div>
              </div>

              {/* Card: Keterangan */}
              <div className="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                <div className="bg-gradient-to-r from-[#2d1b69] to-[#4a2d8a] px-5 py-3.5">
                  <h2 className="text-white font-semibold flex items-center gap-2">
                    <span className="material-symbols-outlined text-lg">description</span>
                    Keterangan
                  </h2>
                </div>
                <div className="p-5">
                  <textarea
                    value={keterangan}
                    onChange={e => setKeterangan(e.target.value)}
                    rows={7}
                    className="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 outline-none transition-all text-sm bg-gray-50/50 resize-none leading-relaxed"
                  />
                </div>
              </div>

              {/* Summary Card */}
              <motion.div
                initial={{ opacity: 0, scale: 0.95 }}
                animate={{ opacity: 1, scale: 1 }}
                transition={{ delay: 0.3 }}
                className="bg-gradient-to-br from-[#2d1b69] to-[#4a2d8a] rounded-2xl p-6 text-white shadow-xl shadow-purple-900/20"
              >
                <h3 className="text-sm font-semibold text-purple-200 uppercase tracking-wider mb-4">Ringkasan</h3>
                <div className="space-y-2.5 text-sm">
                  <div className="flex justify-between">
                    <span className="text-purple-200">Subtotal Barang</span>
                    <span className="font-semibold">{formatRupiah(subtotalBarang)}</span>
                  </div>
                  {Number(ongkirPrice) > 0 && (
                    <div className="flex justify-between">
                      <span className="text-purple-200">Biaya Ongkir</span>
                      <span className="font-semibold">{formatRupiah(ongkirPrice)}</span>
                    </div>
                  )}
                  {ppnEnabled && (
                    <div className="flex justify-between">
                      <span className="text-purple-200">PPN {ppnPercent}%</span>
                      <span className="font-semibold">{formatRupiah(ppnAmount)}</span>
                    </div>
                  )}
                  <div className="border-t border-purple-400/30 pt-3 mt-3">
                    <div className="flex justify-between items-center">
                      <span className="text-base font-bold text-purple-100">GRAND TOTAL</span>
                      <span className="text-xl font-extrabold text-yellow-300">{formatRupiah(grandTotal)}</span>
                    </div>
                  </div>
                </div>

                <div className="flex gap-3 mt-6">
                  <button
                    onClick={() => setShowPreview(!showPreview)}
                    className="flex-1 flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white py-3 rounded-xl font-semibold transition-all text-sm border border-white/10"
                  >
                    <span className="material-symbols-outlined text-lg">visibility</span>
                    {showPreview ? 'Sembunyikan' : 'Lihat'} Preview
                  </button>
                  <button
                    onClick={handlePrint}
                    className="flex-1 flex items-center justify-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-gray-900 py-3 rounded-xl font-bold transition-all text-sm shadow-lg shadow-yellow-500/30"
                  >
                    <span className="material-symbols-outlined text-lg">print</span>
                    Cetak PDF
                  </button>
                </div>
              </motion.div>
            </div>
          </motion.div>

          {/* ─── RIGHT: Live Preview ──────────────────────── */}
          <motion.div
            {...fadeUp}
            transition={{ delay: 0.2, duration: 0.4 }}
            className={`${showPreview ? 'block' : 'hidden'} xl:block`}
          >
            <div className="sticky top-6">
              <div className="flex items-center justify-between mb-3">
                <p className="text-xs font-semibold text-gray-400 uppercase tracking-widest">Live Preview (A4)</p>
                <button
                  onClick={handlePrint}
                  className="flex items-center gap-1.5 text-xs font-semibold text-purple-600 hover:text-purple-800 transition-colors"
                >
                  <span className="material-symbols-outlined text-sm">print</span>
                  Cetak PDF
                </button>
              </div>
              <div className="bg-gray-200/70 rounded-2xl p-4 md:p-6 shadow-inner">
                <InvoicePreview
                  ref={printRef}
                  clientName={clientName}
                  clientLocation={clientLocation}
                  formattedDate={formattedDate}
                  items={items}
                  ongkirDesc={ongkirDesc}
                  ongkirPrice={ongkirPrice}
                  ppnEnabled={ppnEnabled}
                  ppnPercent={ppnPercent}
                  ppnAmount={ppnAmount}
                  subtotalBarang={subtotalBarang}
                  grandTotal={grandTotal}
                  keterangan={keterangan}
                />
              </div>
            </div>
          </motion.div>
        </div>
      </div>

      {/* ═══════════ PRINT-ONLY AREA ═══════════ */}
      <div className="invoice-print-area">
        <InvoicePreview
          clientName={clientName}
          clientLocation={clientLocation}
          formattedDate={formattedDate}
          items={items}
          ongkirDesc={ongkirDesc}
          ongkirPrice={ongkirPrice}
          ppnEnabled={ppnEnabled}
          ppnPercent={ppnPercent}
          ppnAmount={ppnAmount}
          subtotalBarang={subtotalBarang}
          grandTotal={grandTotal}
          keterangan={keterangan}
          isPrint
        />
      </div>
    </div>
  )
}

// ─── Invoice Preview Component ──────────────────────────────────
function InvoicePreview({
  clientName, clientLocation, formattedDate, items,
  ongkirDesc, ongkirPrice, ppnEnabled, ppnPercent, ppnAmount,
  subtotalBarang, grandTotal, keterangan, isPrint
}) {
  const containerClass = isPrint
    ? 'invoice-paper-print'
    : 'invoice-paper bg-white rounded-lg shadow-xl border border-gray-200 aspect-[210/297] overflow-hidden'

  return (
    <div className={containerClass}>
      <div className={isPrint ? 'p-[40px]' : 'p-5 text-[9px] leading-snug'} style={isPrint ? { fontSize: '11px', lineHeight: '1.4' } : {}}>
        {/* ── Header ── */}
        <div className="flex items-start gap-3 mb-1">
          {/* Logo */}
          <div className="flex-shrink-0" style={{ width: isPrint ? '90px' : '50px' }}>
            <div style={{
              width: isPrint ? '80px' : '45px',
              height: isPrint ? '70px' : '40px',
              background: 'linear-gradient(135deg, #c62828, #1565c0)',
              borderRadius: isPrint ? '8px' : '4px',
              display: 'flex',
              flexDirection: 'column',
              alignItems: 'center',
              justifyContent: 'center',
              color: 'white',
              fontWeight: '800',
              fontSize: isPrint ? '28px' : '16px',
              lineHeight: 1,
            }}>
              <span>A</span>
              <span style={{ fontSize: isPrint ? '6px' : '3.5px', fontWeight: '600', letterSpacing: '0.5px', marginTop: '2px' }}>CV. Asianindo</span>
            </div>
            <p style={{ fontSize: isPrint ? '6px' : '3.5px', color: '#1565c0', marginTop: '2px', textAlign: 'center' }}>www.asianindo.com</p>
          </div>

          {/* Company Info */}
          <div className="flex-1 text-center">
            <h1 style={{
              color: '#1565c0',
              fontWeight: '800',
              fontSize: isPrint ? '22px' : '13px',
              marginBottom: isPrint ? '4px' : '2px',
            }}>
              CV. ASIANINDO
            </h1>
            <p style={{ fontSize: isPrint ? '9px' : '5.5px', fontWeight: '600', color: '#333' }}>
              Workshop Mesin Pengolahan Makanan, Pertanian, dan Mesin Industri
            </p>
            <p style={{ fontSize: isPrint ? '8px' : '5px', color: '#555', marginTop: '2px' }}>
              Alamat:·Jl. Pemuda No.41 RT.2/RW.1 Permisan Jabon, Sidoarjo-Jawa Timur, 61276
            </p>
            <p style={{ fontSize: isPrint ? '8px' : '5px', color: '#555' }}>
              ²The Tlogowaru Hills No.01 Blok A Kedungkandang Kota Malang-
            </p>
            <p style={{ fontSize: isPrint ? '8px' : '5px', color: '#555' }}>
              Jawa Timur, 65132
            </p>
            <p style={{ fontSize: isPrint ? '9px' : '5.5px', fontWeight: '600', color: '#333', marginTop: '2px' }}>
              No HP. +62 823-3527-3227
            </p>
          </div>
        </div>

        {/* ── INVOICE Title ── */}
        <div style={{
          borderTop: '2px solid #333',
          borderBottom: '2px solid #333',
          padding: isPrint ? '6px 0' : '3px 0',
          margin: isPrint ? '12px 0' : '6px 0',
          textAlign: 'center',
        }}>
          <h2 style={{ fontWeight: '800', fontSize: isPrint ? '18px' : '11px', letterSpacing: '3px' }}>INVOICE</h2>
        </div>

        {/* ── Client & Date ── */}
        <div className="flex justify-between" style={{ margin: isPrint ? '12px 0' : '6px 0' }}>
          <div>
            <p><strong>Kpd Yth:</strong></p>
            <p style={{ marginLeft: isPrint ? '16px' : '8px' }}>{clientName || '.....................'}</p>
            {clientLocation && <p style={{ marginLeft: isPrint ? '16px' : '8px' }}>{clientLocation}</p>}
            <p style={{ marginTop: isPrint ? '6px' : '3px' }}><strong>Di_</strong></p>
            <p style={{ marginLeft: isPrint ? '16px' : '8px' }}>Tempat</p>
          </div>
          <div style={{ textAlign: 'right' }}>
            <p>{formattedDate}</p>
          </div>
        </div>

        {/* ── Table ── */}
        <table style={{
          width: '100%',
          borderCollapse: 'collapse',
          marginTop: isPrint ? '12px' : '6px',
          fontSize: isPrint ? '10px' : 'inherit',
        }}>
          <thead>
            <tr style={{ backgroundColor: '#e0e0e0' }}>
              <th style={thStyle(isPrint)}>NO</th>
              <th style={{ ...thStyle(isPrint), textAlign: 'left', width: '18%' }}>NAMA BARANG</th>
              <th style={{ ...thStyle(isPrint), textAlign: 'left', width: '32%' }}>SPESIFIKASI</th>
              <th style={thStyle(isPrint)}>Q</th>
              <th style={{ ...thStyle(isPrint), textAlign: 'right' }}>HARGA @</th>
              <th style={{ ...thStyle(isPrint), textAlign: 'right' }}>TOTAL</th>
            </tr>
          </thead>
          <tbody>
            {items.map((item, idx) => (
              <tr key={item.id}>
                <td style={tdStyle(isPrint)}>{idx + 1}.</td>
                <td style={{ ...tdStyle(isPrint), fontWeight: '600' }}>{item.nama || '-'}</td>
                <td style={tdStyle(isPrint)}>
                  {item.spesifikasi ? (
                    <ul style={{ margin: 0, paddingLeft: isPrint ? '16px' : '10px', listStyleType: 'disc' }}>
                      {item.spesifikasi.split('\n').filter(Boolean).map((line, li) => (
                        <li key={li}>{line}</li>
                      ))}
                    </ul>
                  ) : '-'}
                </td>
                <td style={{ ...tdStyle(isPrint), textAlign: 'center' }}>{item.qty}</td>
                <td style={{ ...tdStyle(isPrint), textAlign: 'right', whiteSpace: 'nowrap' }}>{item.harga > 0 ? formatRupiah(item.harga) : '-'}</td>
                <td style={{ ...tdStyle(isPrint), textAlign: 'right', whiteSpace: 'nowrap' }}>{item.harga > 0 ? formatRupiah(item.qty * item.harga) : '-'}</td>
              </tr>
            ))}

            {/* Ongkir Row */}
            {Number(ongkirPrice) > 0 && (
              <tr>
                <td style={tdStyle(isPrint)}>{items.length + 1}.</td>
                <td style={{ ...tdStyle(isPrint), fontWeight: '600' }}>Biaya Ongkir</td>
                <td style={tdStyle(isPrint)}>
                  <ul style={{ margin: 0, paddingLeft: isPrint ? '16px' : '10px', listStyleType: 'disc' }}>
                    <li>{ongkirDesc || 'Ongkir'}</li>
                  </ul>
                </td>
                <td style={{ ...tdStyle(isPrint), textAlign: 'center' }}></td>
                <td style={{ ...tdStyle(isPrint), textAlign: 'right', whiteSpace: 'nowrap' }}>{formatRupiah(ongkirPrice)}</td>
                <td style={{ ...tdStyle(isPrint), textAlign: 'right', whiteSpace: 'nowrap' }}>{formatRupiah(ongkirPrice)}</td>
              </tr>
            )}

            {/* PPN Row */}
            {ppnEnabled && (
              <tr>
                <td style={tdStyle(isPrint)}>{items.length + (Number(ongkirPrice) > 0 ? 2 : 1)}.</td>
                <td style={{ ...tdStyle(isPrint), fontWeight: '600' }}>PPN {ppnPercent}%</td>
                <td style={tdStyle(isPrint)}></td>
                <td style={{ ...tdStyle(isPrint), textAlign: 'center' }}></td>
                <td style={{ ...tdStyle(isPrint), textAlign: 'right', whiteSpace: 'nowrap' }}>{formatRupiah(ppnAmount)}</td>
                <td style={{ ...tdStyle(isPrint), textAlign: 'right', whiteSpace: 'nowrap' }}>{formatRupiah(ppnAmount)}</td>
              </tr>
            )}

            {/* TOTAL Row */}
            <tr>
              <td colSpan="5" style={{
                ...tdStyle(isPrint),
                textAlign: 'center',
                fontWeight: '800',
                backgroundColor: '#fdd835',
                fontSize: isPrint ? '12px' : 'inherit',
              }}>
                TOTAL
              </td>
              <td style={{
                ...tdStyle(isPrint),
                textAlign: 'right',
                fontWeight: '800',
                backgroundColor: '#fdd835',
                whiteSpace: 'nowrap',
                fontSize: isPrint ? '12px' : 'inherit',
              }}>
                {formatRupiah(grandTotal)}
              </td>
            </tr>
          </tbody>
        </table>

        {/* ── Keterangan ── */}
        <div style={{ marginTop: isPrint ? '16px' : '8px' }}>
          <p style={{ fontWeight: '700', marginBottom: isPrint ? '4px' : '2px' }}>Keterangan:</p>
          <ul style={{ margin: 0, paddingLeft: isPrint ? '20px' : '12px', listStyleType: 'disc' }}>
            {keterangan.split('\n').filter(Boolean).map((line, li) => (
              <li key={li} style={{
                listStyleType: line.startsWith('-') ? 'none' : 'disc',
                marginLeft: line.startsWith('-') ? (isPrint ? '8px' : '4px') : 0,
              }}>
                {line}
              </li>
            ))}
          </ul>
        </div>

        {/* ── Signature ── */}
        <div className="flex justify-end" style={{ marginTop: isPrint ? '24px' : '12px' }}>
          <div style={{ textAlign: 'center', width: isPrint ? '200px' : '120px' }}>
            <p style={{ fontStyle: 'italic' }}>Hormat kami,</p>
            <p style={{ fontWeight: '700', color: '#1565c0', fontSize: isPrint ? '13px' : '8px' }}>CV. Asianindo</p>
            <div style={{
              width: isPrint ? '70px' : '40px',
              height: isPrint ? '60px' : '35px',
              margin: '4px auto',
              background: 'linear-gradient(135deg, #c62828, #1565c0)',
              borderRadius: isPrint ? '6px' : '3px',
              display: 'flex',
              flexDirection: 'column',
              alignItems: 'center',
              justifyContent: 'center',
              color: 'white',
              fontWeight: '800',
              fontSize: isPrint ? '22px' : '14px',
              lineHeight: 1,
            }}>
              <span>A</span>
              <span style={{ fontSize: isPrint ? '5px' : '3px', fontWeight: '600', marginTop: '1px' }}>Asianindo</span>
            </div>
            <div style={{
              borderBottom: '1px solid #333',
              paddingBottom: isPrint ? '4px' : '2px',
              marginBottom: isPrint ? '4px' : '2px',
            }}>
              <p style={{ fontWeight: '700', fontSize: isPrint ? '10px' : '6px', textTransform: 'uppercase' }}>IMAN ANJANI BUCHORY S.E</p>
            </div>
            <p style={{ fontSize: isPrint ? '9px' : '5px', fontWeight: '600' }}>DIREKTUR</p>
          </div>
        </div>
      </div>
    </div>
  )
}

// ─── Table Style Helpers ─────────────────────────────────────────
const thStyle = (isPrint) => ({
  border: '1px solid #999',
  padding: isPrint ? '6px 8px' : '3px 4px',
  fontWeight: '700',
  textAlign: 'center',
  fontSize: isPrint ? '10px' : 'inherit',
})

const tdStyle = (isPrint) => ({
  border: '1px solid #999',
  padding: isPrint ? '6px 8px' : '3px 4px',
  verticalAlign: 'top',
})
